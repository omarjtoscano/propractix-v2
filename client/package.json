{
  "name": "@propractix/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11.9.0 <11.10.0"
  },
  "scripts": {
    "lint": "node scripts/check-visible-text.mjs && node scripts/check-i18n-parity.mjs",
